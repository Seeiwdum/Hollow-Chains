MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 8f555a5ca2be1d047b4dd78d780532a6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13654884352
    m_Localized: Father's face... torn out. I hid it again.
    m_Metadata:
      m_Items: []
  - m_Id: 15500378112
    m_Localized: Elena gave me this. It's still alive.
    m_Metadata:
      m_Items: []
  - m_Id: 15500378113
    m_Localized: An old chain... why do I keep this?
    m_Metadata:
      m_Items: []
  - m_Id: 15500378114
    m_Localized: It has never ticked. Not once. ...Still, I can't throw it away.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572416
    m_Localized: ...The latch clicks shut from inside.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572417
    m_Localized: He looks straight through me.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572418
    m_Localized: Still here. Still his name.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572419
    m_Localized: It doesn't matter. Elena is waiting at the stream.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572420
    m_Localized: ...that's the murderer's boy.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572421
    m_Localized: Don't look at him. Keep walking.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572422
    m_Localized: Born empty. Like a curse.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572423
    m_Localized: Mama says he has no magic at all!
    m_Metadata:
      m_Items: []
  - m_Id: 15504572424
    m_Localized: Claw marks... too big for any wolf.
    m_Metadata:
      m_Items: []
  - m_Id: 15504572425
    m_Localized: Villager
    m_Metadata:
      m_Items: []
  - m_Id: 15504572426
    m_Localized: Child
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
