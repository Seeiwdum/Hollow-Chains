  m_Name: Dialogue_th
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: th
  m_SharedData: {fileID: 11400000, guid: 8f555a5ca2be1d047b4dd78d780532a6, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13654884352
    m_Localized: "\u0E2B\u0E19\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E1E\u0E48\u0E2D\u2026
      \u0E16\u0E39\u0E01\u0E09\u0E35\u0E01\u0E2D\u0E2D\u0E01\u0E44\u0E1B \u0E09\u0E31\u0E19\u0E40\u0E2D\u0E32\u0E21\u0E31\u0E19\u0E44\u0E1B\u0E0B\u0E48\u0E2D\u0E19\u0E2D\u0E35\u0E01\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 15500378112
    m_Localized: "\u0E14\u0E2D\u0E01\u0E44\u0E21\u0E49\u0E17\u0E35\u0E48\u0E40\u0E2D\u0E40\u0E25\u0E19\u0E32\u0E43\u0E2B\u0E49\u2026
      \u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E35\u0E48\u0E22\u0E27\u0E40\u0E25\u0E22"
    m_Metadata:
      m_Items: []
  - m_Id: 15500378113
    m_Localized: "\u0E42\u0E0B\u0E48\u0E40\u0E01\u0E48\u0E32\u0E40\u0E2A\u0E49\u0E19\u0E19\u0E35\u0E49\u2026
      \u0E17\u0E33\u0E44\u0E21\u0E09\u0E31\u0E19\u0E16\u0E36\u0E07\u0E22\u0E31\u0E07\u0E40\u0E01\u0E47\u0E1A\u0E21\u0E31\u0E19\u0E44\u0E27\u0E49\u0E19\u0E30"
    m_Metadata:
      m_Items: []
  - m_Id: 15500378114
    m_Localized: "\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E40\u0E04\u0E22\u0E40\u0E14\u0E34\u0E19\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07\u2026
      \u0E41\u0E15\u0E48\u0E09\u0E31\u0E19\u0E01\u0E47\u0E17\u0E34\u0E49\u0E07\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E25\u0E07"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572416
    m_Localized: "\u2026\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E25\u0E07\u0E01\u0E25\u0E2D\u0E19\u0E14\u0E31\u0E07\u0E21\u0E32\u0E08\u0E32\u0E01\u0E02\u0E49\u0E32\u0E07\u0E43\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572417
    m_Localized: "\u0E40\u0E02\u0E32\u0E21\u0E2D\u0E07\u0E17\u0E30\u0E25\u0E38\u0E09\u0E31\u0E19\u0E44\u0E1B
      \u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E21\u0E35\u0E15\u0E31\u0E27\u0E15\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572418
    m_Localized: "\u0E22\u0E31\u0E07\u0E15\u0E34\u0E14\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E40\u0E14\u0E34\u0E21\u2026
      \u0E0A\u0E37\u0E48\u0E2D\u0E02\u0E2D\u0E07\u0E1E\u0E48\u0E2D"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572419
    m_Localized: "\u0E0A\u0E48\u0E32\u0E07\u0E40\u0E16\u0E2D\u0E30\u2026 \u0E40\u0E2D\u0E40\u0E25\u0E19\u0E32\u0E23\u0E2D\u0E2D\u0E22\u0E39\u0E48\u0E17\u0E35\u0E48\u0E25\u0E33\u0E18\u0E32\u0E23"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572420
    m_Localized: "\u2026\u0E19\u0E31\u0E48\u0E19\u0E44\u0E07 \u0E25\u0E39\u0E01\u0E02\u0E2D\u0E07\u0E06\u0E32\u0E15\u0E01\u0E23"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572421
    m_Localized: "\u0E2D\u0E22\u0E48\u0E32\u0E44\u0E1B\u0E21\u0E2D\u0E07\u0E21\u0E31\u0E19
      \u0E40\u0E14\u0E34\u0E19\u0E15\u0E48\u0E2D\u0E44\u0E1B"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572422
    m_Localized: "\u0E40\u0E01\u0E34\u0E14\u0E21\u0E32\u0E27\u0E48\u0E32\u0E07\u0E40\u0E1B\u0E25\u0E48\u0E32\u2026
      \u0E2D\u0E22\u0E48\u0E32\u0E07\u0E01\u0E31\u0E1A\u0E04\u0E33\u0E2A\u0E32\u0E1B"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572423
    m_Localized: "\u0E41\u0E21\u0E48\u0E1A\u0E2D\u0E01\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E27\u0E17\u0E40\u0E25\u0E22\u0E2A\u0E31\u0E01\u0E19\u0E34\u0E14!"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572424
    m_Localized: "\u0E23\u0E2D\u0E22\u0E02\u0E48\u0E27\u0E19\u2026 \u0E43\u0E2B\u0E0D\u0E48\u0E40\u0E01\u0E34\u0E19\u0E01\u0E27\u0E48\u0E32\u0E08\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E2B\u0E21\u0E32\u0E1B\u0E48\u0E32\u0E18\u0E23\u0E23\u0E21\u0E14\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572425
    m_Localized: "\u0E0A\u0E32\u0E27\u0E1A\u0E49\u0E32\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 15504572426
    m_Localized: "\u0E40\u0E14\u0E47\u0E01"
    m_Metadata:
      m_Items: []
  - m_Id: 20259379937280
    m_Localized: "\u0E40\u0E2D\u0E40\u0E25\u0E19\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 20260764057600
    m_Localized: "\u0E2D\u0E22\u0E48\u0E32\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E19\u0E30!"
    m_Metadata:
      m_Items: []
  - m_Id: 20262445973504
    m_Localized: "\u0E2D\u0E22\u0E48\u0E32\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E43\u0E01\u0E25\u0E49\u0E09\u0E31\u0E19!
      \u0E1E\u0E25\u0E31\u0E07\u0E14\u0E39\u0E14\u0E27\u0E34\u0E0D\u0E0D\u0E32\u0E13\u0E19\u0E31\u0E48\u0E19..."
    m_Metadata:
      m_Items: []
  - m_Id: 20263100284928
    m_Localized: "\u0E41\u0E01\u0E21\u0E31\u0E19\u0E01\u0E47\u0E2A\u0E31\u0E15\u0E27\u0E4C\u0E1B\u0E23\u0E30\u0E2B\u0E25\u0E32\u0E14\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E1E\u0E48\u0E2D\u0E02\u0E2D\u0E07\u0E41\u0E01!"
    m_Metadata:
      m_Items: []
  - m_Id: 20263859453952
    m_Localized: "\u0E17\u0E35\u0E48\u0E1C\u0E48\u0E32\u0E19\u0E21\u0E32\u0E41\u0E01\u0E41\u0E01\u0E25\u0E49\u0E07\u0E17\u0E33\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E14\u0E35\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E08\u0E30\u0E06\u0E48\u0E32\u0E09\u0E31\u0E19\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21?!"
    m_Metadata:
      m_Items: []
  - m_Id: 20264534736896
    m_Localized: "\u0E08\u0E07\u0E2B\u0E19\u0E35\u0E44\u0E1B... \u0E1C\u0E19\u0E36\u0E01\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E30\u0E41\u0E15\u0E01\u0E41\u0E25\u0E49\u0E27"
    m_Metadata:
      m_Items: []
  - m_Id: 20502792175616
    m_Localized: ???
    m_Metadata:
      m_Items: []
  - m_Id: 20502796369920
    m_Localized: "...\u0E17\u0E48\u0E32\u0E21\u0E01\u0E25\u0E32\u0E07\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E17\u0E35\u0E48\u0E40\u0E2B\u0E22\u0E35\u0E22\u0E14\u0E2B\u0E22\u0E32\u0E21\u0E41\u0E25\u0E30\u0E42\u0E25\u0E01\u0E17\u0E35\u0E48\u0E21\u0E37\u0E14\u0E21\u0E19"
    m_Metadata:
      m_Items: []
  - m_Id: 20503723311104
    m_Localized: "\u0E02\u0E49\u0E32\u0E22\u0E31\u0E07\u0E21\u0E35\u0E40\u0E18\u0E2D\u0E1A\u0E19\u0E42\u0E25\u0E01\u0E43\u0E1A\u0E19\u0E35\u0E49
      '\u0E40\u0E2D\u0E40\u0E25\u0E19\u0E32' (Elena) \u0E40\u0E14\u0E47\u0E01\u0E2B\u0E0D\u0E34\u0E07\u0E40\u0E1E\u0E35\u0E22\u0E07\u0E04\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27\u0E43\u0E19\u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E40\u0E04\u0E22\u0E23\u0E31\u0E07\u0E40\u0E01\u0E35\u0E22\u0E08\u0E02\u0E49\u0E32"
    m_Metadata:
      m_Items: []
  - m_Id: 20504021106688
    m_Localized: "\u0E40\u0E18\u0E2D\u0E22\u0E2D\u0E21\u0E25\u0E30\u0E17\u0E34\u0E49\u0E07\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E04\u0E19\u0E23\u0E2D\u0E1A\u0E02\u0E49\u0E32\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E21\u0E32\u0E27\u0E34\u0E48\u0E07\u0E40\u0E25\u0E48\u0E19\u0E41\u0E25\u0E30\u0E2B\u0E31\u0E27\u0E40\u0E23\u0E32\u0E30\u0E01\u0E31\u0E1A\u0E40\u0E14\u0E47\u0E01\u0E44\u0E23\u0E49\u0E1E\u0E25\u0E31\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E02\u0E49\u0E32..."
    m_Metadata:
      m_Items: []
  - m_Id: 20504360845312
    m_Localized: "\u0E40\u0E18\u0E2D\u0E04\u0E37\u0E2D\u0E41\u0E2A\u0E07\u0E2A\u0E27\u0E48\u0E32\u0E07\u0E41\u0E25\u0E30\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25\u0E40\u0E14\u0E35\u0E22\u0E27\u0E17\u0E35\u0E48\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E22\u0E31\u0E07\u0E2D\u0E22\u0E32\u0E01\u0E21\u0E35\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E2D\u0E22\u0E39\u0E48..."
    m_Metadata:
      m_Items: []
  - m_Id: 20504784470016
    m_Localized: "\u0E01\u0E23\u0E35\u0E4A\u0E14\u2014! \u0E0A\u0E48\u0E27\u0E22\u0E14\u0E49\u0E27\u0E22!"
    m_Metadata:
      m_Items: []
